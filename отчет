generate_give() - выдача предметов

generate_summon() - призыв существ

generate_setblock() - установка блоков

generate_effect() - эффекты

generate_time() - время

generate_weather() - погода

generate_gamerule() - правила игры

generate_clone() - клонирование

generate_particle() - частицы

