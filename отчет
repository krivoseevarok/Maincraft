5.2. Генерация UUID для атрибутов
\\
def generate_uuid(self):
    """Генерирует UUID в формате для Minecraft (16-битные значения)"""
    uuids = []
    for _ in range(4):
        u = uuid.uuid4()
        uuid_int = int(u.hex[:4], 16)
        uuids.append(uuid_int)
    return uuids
